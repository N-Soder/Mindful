<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ FORK: Cooldown gate overlay.
  ~
  ~ Two phases share this one view so the transition can be a simple cross-fade with
  ~ no window teardown: the breath panel fades out, the info panel fades in.
  ~
  ~ Colours come from the existing role names in values/colors.xml, so this tracks the
  ~ app's light/dark palette without any new resources.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cooldown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Phase 1: breathing pause -->
    <FrameLayout
        android:id="@+id/cooldown_breath_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The breathing circle. Scaled by ObjectAnimator; sits behind the text. -->
        <View
            android:id="@+id/cooldown_breath_circle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:alpha="0.28"
            android:background="@drawable/shape_circular"
            android:backgroundTint="@color/accent" />

        <TextView
            android:id="@+id/cooldown_breath_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="@string/cooldown_breath_prompt"
            android:textColor="@color/textPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Phase 2: usage context and the choice -->
    <LinearLayout
        android:id="@+id/cooldown_info_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Centred stats block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/cooldown_attempts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cooldown_attempts_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/cooldown_screen_time_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="@color/textSecondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cooldown_last_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/textSecondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Actions. The way out is the prominent one; continuing is deliberately quiet. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <Button
                android:id="@+id/cooldown_btn_dismiss"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/shape_rounded_lg"
                android:backgroundTint="@color/accent"
                android:textAllCaps="false"
                android:textColor="@color/secondaryContainer"
                android:textSize="17sp" />

            <Button
                android:id="@+id/cooldown_btn_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
