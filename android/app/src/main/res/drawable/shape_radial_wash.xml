<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ FORK: Soft radial falloff for the cooldown gate's breathing phase.
  ~
  ~ Two things here are load-bearing:
  ~
  ~ 1. An oval, not a rectangle. A rectangle's straight sides cut the gradient off, and
  ~    scaling it up made those hard edges and corners plainly visible — the wash stopped
  ~    reading as a soft circle.
  ~
  ~ 2. An absolute gradientRadius, not a percentage. It must complete *inside* the view's
  ~    bounds or the shape clips it again, and %p resolution for shape drawables is
  ~    inconsistent. The view is a fixed 480dp square (see the layout), so 220dp finishes
  ~    with 20dp of margin at rest and stays clear at full scale.
  ~
  ~ Uses @color/accent directly so it inherits Material You from values-v31. Tinting is
  ~ deliberately avoided — backgroundTint applies flatly and would destroy the gradient.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="220dp"
        android:startColor="@color/accent"
        android:endColor="@android:color/transparent" />
</shape>
